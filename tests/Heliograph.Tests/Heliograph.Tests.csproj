<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../benchmarks/**/*" LinkBase="benchmarks" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../docs/*.md" LinkBase="docs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../README.md" Link="docs/README-root.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Examples/*.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Heliograph/Heliograph.csproj" />
    <ProjectReference Include="../../src/Heliograph.Pdf.LibreOffice/Heliograph.Pdf.LibreOffice.csproj" />
  </ItemGroup>

</Project>
