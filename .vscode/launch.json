{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C#: Aspire (Full Stack)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Reference host: prepare AppHost",
      "program": "${workspaceFolder}/reference/Heliograph.AppHost/bin/Debug/net10.0/Heliograph.AppHost.dll",
      "cwd": "${workspaceFolder}/reference/Heliograph.AppHost",
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:17296;http://localhost:15196",
        "DOTNET_DASHBOARD_OTLP_ENDPOINT_URL": "https://localhost:21296",
        "DOTNET_RESOURCE_SERVICE_ENDPOINT_URL": "https://localhost:22296",
        // Local dev only: skips the dashboard's browser-token login prompt so VS Code can open it straight to the
        // URL below. Never set this outside a local debug session; it turns the dashboard's own sign-in off.
        "DOTNET_DASHBOARD_UNSECURED_ALLOW_ANONYMOUS": "true"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Distributed application started\\.",
        "uriFormat": "https://localhost:17296"
      }
    },
    {
      "name": "C#: Heliograph.ReferenceApp (standalone)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dotnet: build ReferenceApp",
      "program": "${workspaceFolder}/reference/Heliograph.ReferenceApp/bin/Debug/net10.0/Heliograph.ReferenceApp.dll",
      "cwd": "${workspaceFolder}/reference/Heliograph.ReferenceApp",
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7296;http://localhost:5296"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https://\\S+)",
        "uriFormat": "%s/heliograph"
      }
    }
  ]
}
